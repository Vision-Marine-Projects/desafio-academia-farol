# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Senha dos usuários de teste criados pelo `npm run seed`
SEED_SENHA=Farol@2026

# Assistente do Aluno
# LLM_PROVEDOR: simulado | anthropic | openai | gemini | ollama
#   simulado = sem LLM e sem chave; útil para desenvolver e testar as tools.
LLM_PROVEDOR=simulado
# Nome do modelo do provedor escolhido. Confira o nome atual na documentação dele.
# Exemplos: claude-haiku-5-5 (anthropic) · gpt-4o-mini (openai) · gemini-2.5-flash (gemini) · llama3.1 (ollama)
LLM_MODELO=
# Chave da API do provedor (não precisa para simulado nem ollama)
LLM_API_KEY=
# Só para ollama (padrão http://localhost:11434/v1)
LLM_BASE_URL=
